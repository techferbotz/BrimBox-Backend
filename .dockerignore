# Keep the build context small and never ship secrets or local cruft.
# Do NOT ignore src/, tsconfig.json or package*.json — the build needs them.

node_modules
dist

# Local environment & secrets
.env
.env.*

# Git / editor / OS
.git
.gitignore
.gitattributes
.claude
.vscode
.idea
.DS_Store
Thumbs.db

# Docker & docs (not needed at runtime)
Dockerfile
.dockerignore
docker-compose*.yml
docs
*.md

# Logs / deploy bookkeeping
*.log
deploy.out
deploy.pid

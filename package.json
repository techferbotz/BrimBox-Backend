{
  "name": "brimbox-backend",
  "version": "0.1.0",
  "private": true,
  "description": "Backend for BrimBox — pay-as-you-use cloud storage",
  "license": "UNLICENSED",
  "main": "dist/app.js",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "ts-node-dev --respawn --transpile-only --exit-child src/app.ts",
    "build": "tsc",
    "start": "node dist/app.js",
    "typecheck": "tsc --noEmit",
    "check:config": "ts-node src/scripts/check-remote-config.ts",
    "check:legal": "ts-node src/scripts/check-legal.ts",
    "check:all": "npm run check:config && npm run check:legal"
  },
  "dependencies": {
    "cors": "^2.8.6",
    "dotenv": "^17.4.2",
    "express": "^5.2.1"
  },
  "devDependencies": {
    "@types/cors": "^2.8.19",
    "@types/express": "^5.0.6",
    "@types/node": "^25.0.0",
    "ts-node": "^10.9.2",
    "ts-node-dev": "^2.0.0",
    "typescript": "^5.9.3"
  }
}
